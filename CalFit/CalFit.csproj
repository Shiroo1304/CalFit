<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>

		<RootNamespace>CalFit</RootNamespace>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Application identity -->
		<ApplicationTitle>CalFit</ApplicationTitle>
		<ApplicationId>com.calfit.prototype</ApplicationId>

		<!-- Application version -->
		<ApplicationDisplayVersion>2.1</ApplicationDisplayVersion>
		<ApplicationVersion>21</ApplicationVersion>

		<!-- Android configuration -->
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
		<AndroidUseCleartextTraffic>true</AndroidUseCleartextTraffic>
	</PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(CalFitBotSimulation)' == 'true'">
        <DefineConstants>$(DefineConstants);CALFITBOT_SIMULATION</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <EmbeddedResource Include="Resources/Raw/calfitbot_sample.jpg" LogicalName="CalFit.Bot.Sample.jpg" />
    </ItemGroup>
    <Target Name="ValidateCalFitBotSimulation" BeforeTargets="PrepareForBuild"
            Condition="'$(Configuration)' != 'Debug' and '$(CalFitBotSimulation)' == 'true'">
        <Error Text="CalFitBot simulation is available only in Debug builds." />
    </Target>

	<!-- App icon and splash screen -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\calfitlogo.png" BaseSize="1024,1024" />

		<MauiSplashScreen Include="Resources\AppIcon\calfitlogo.png" Color="#07130F" BaseSize="128,128" />
	</ItemGroup>

	<!-- MAUI dependencies -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />

		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
	</ItemGroup>

	<!-- Blazor assets -->
	<ItemGroup>
		<MauiAsset Include="wwwroot\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
