@inject CalFitApi Api
@inject AppearanceService Appearance
<div class="screen"><header class="page-heading"><div><span class="eyebrow">PERSONALIZE CALFIT</span><h1>Settings<span class="accent">.</span></h1><p>Make the experience your own.</p></div>></header>
    <div class="section-head"><div><span class="eyebrow">APPEARANCE</span><h2>Choose your mood</h2></div></div>
    <div class="theme-grid"><button class="theme-card @(Appearance.Theme == "emerald" ? "theme-selected" : "")" @onclick='() => SetTheme("emerald")'><span class="theme-sample emerald-sample"><i></i><i></i><i></i></span><strong>Emerald</strong><small>CalFit signature</small></button><button class="theme-card @(Appearance.Theme == "midnight" ? "theme-selected" : "")" @onclick='() => SetTheme("midnight")'><span class="theme-sample midnight-sample"><i></i><i></i><i></i></span><strong>Midnight</strong><small>Deep blue</small></button><button class="theme-card @(Appearance.Theme == "violet" ? "theme-selected" : "")" @onclick='() => SetTheme("violet")'><span class="theme-sample violet-sample"><i></i><i></i><i></i></span><strong>Amethyst</strong><small>Purple glow</small></button><button class="theme-card @(Appearance.Theme == "light" ? "theme-selected" : "")" @onclick='() => SetTheme("light")'><span class="theme-sample light-sample"><i></i><i></i><i></i></span><strong>Daylight</strong><small>Bright and fresh</small></button></div>
    <div class="surface form-surface" style="margin-top:13px"><label class="field-label">Custom accent color</label><div class="button-row" style="align-items:center"><input aria-label="Custom accent color" type="color" style="width:62px;height:43px;border:0;background:transparent" value="@AccentPicker" @onchange="ChangeAccent"/><button class="btn btn-outline" @onclick="ResetAccent">Use preset accent</button></div><p class="small muted">Personalize buttons and highlights. Your choice is saved on this device.</p></div>
    @* <div class="surface form-surface font-settings"><div class="setting-line"><div><strong>Text size</strong><small>Scale interface text for comfort</small></div><strong>@Math.Round(Appearance.FontScale * 100)%</strong></div><input aria-label="Text size" type="range" min="0.9" max="1.25" step="0.05" value="@Appearance.FontScale.ToString(System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnFontScale"/></div> *@
    <div class="section-head"><div><span class="eyebrow">DEVELOPER & DEVICE</span><h2>Backend connection</h2></div></div>
    <div class="surface form-surface"><label class="field-label">CalFit API base URL</label><input class="field" @bind="url" placeholder="http://10.0.2.2:5206/" spellcheck="false"/><div class="button-row"><button class="btn btn-primary" @onclick="SaveUrl">Save API URL</button><button class="btn btn-outline" disabled="@testing" @onclick="TestAsync">@(testing ? "Testing…" : "Test connection")</button></div>@if (!string.IsNullOrWhiteSpace(message)) { <div class="notice @(connectionOk ? "success" : "error")">@message</div> }<div class="connection-guide"><strong>Android addresses</strong><p>Emulator: <code>http://10.0.2.2:5206/</code></p><p>USB phone: <code>http://127.0.0.1:5206/</code> after <code>adb reverse tcp:5206 tcp:5206</code></p><p>Wi-Fi phone: use the reachable LAN IP and port your API listens on. HTTP is for local development; use HTTPS when deployed.</p></div></div>
    <button class="device-banner" @onclick="() => OpenDevice.InvokeAsync()"><span>▣</span><span><strong>CalFit hardware integration</strong><small>View the robot's current integration status</small></span><span>›</span></button>
    <div class="bottom-whitespace"></div></div>
@code {
    [Parameter] public EventCallback OpenDevice { get; set; }
    private string url = "", message = "";
    private string AccentPicker => !string.IsNullOrWhiteSpace(Appearance.CustomAccent) ? Appearance.CustomAccent : Appearance.Theme switch { "midnight" => "#84B8FF", "violet" => "#CBA5FF", "light" => "#198756", _ => "#69E0A6" };
    private void ChangeAccent(ChangeEventArgs e) { try { Appearance.CustomAccent = e.Value?.ToString() ?? ""; } catch { } }
    private void ResetAccent() => Appearance.CustomAccent = "";
    private bool connectionOk, testing;
    protected override void OnInitialized() => url = Api.BaseUrl;
    private void SetTheme(string choice) => Appearance.Theme = choice;
    private void OnFontScale(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value)) Appearance.FontScale = value;
    }
    private void SaveUrl()
    {
        try { Api.BaseUrl = url; url = Api.BaseUrl; message = "Backend address saved. Test the connection before proceeding."; connectionOk = true; }
        catch (Exception ex) { message = ex.Message; connectionOk = false; }
    }
    private async Task TestAsync()
    {
        try { Api.BaseUrl = url; testing = true; connectionOk = await Api.PingAsync(); message = connectionOk ? "✓ CalFit.Api is reachable." : "Backend unreachable. Check that the API is running and use the right address for this Android device."; }
        catch (Exception ex) { message = ex.Message; connectionOk = false; }
        finally { testing = false; }
    }
}
