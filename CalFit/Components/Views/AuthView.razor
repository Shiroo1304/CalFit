@inject AuthSession Session
@inject CalFitApi Api
<div class="auth-screen">
    <div class="auth-light light-one"></div><div class="auth-light light-two"></div>
    <div class="auth-top"><div class="auth-logo">✦</div><h1>Welcome to <em>CalFit.</em></h1><p>Your nutrition. Your pace. A healthier you.</p></div>
    <form class="auth-card" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <div class="eyebrow">@((register) ? "CREATE YOUR ACCOUNT" : "GOOD TO HAVE YOU BACK")</div>
        <h2>@(register ? "Let's get started" : "Sign in to continue")</h2>
        @if (register)
        {
            <label class="field-label" for="auth-name">Your name</label><input id="auth-name" class="field" placeholder="Full name" @bind="name" maxlength="100" autocomplete="name" />
        }
        <label class="field-label" for="auth-email">Email address</label><input id="auth-email" class="field" placeholder="you@example.com" @bind="email" type="email" autocomplete="email" />
        <label class="field-label" for="auth-password">Password</label><input id="auth-password" class="field" placeholder="At least 8 characters" @bind="password" type="password" autocomplete="@(register ? "new-password" : "current-password")" />
        @if (register)
        {
            <label class="field-label" for="auth-confirm">Confirm password</label><input id="auth-confirm" class="field" @bind="confirm" type="password" autocomplete="new-password" />
        }
        @if (!string.IsNullOrWhiteSpace(error)) { <div class="notice error" role="alert">@error</div> }
        @if (!string.IsNullOrWhiteSpace(success)) { <div class="notice success" role="status">@success</div> }
        <button type="submit" class="btn btn-primary full" disabled="@busy">@(busy ? "Please wait…" : register ? "Create account →" : "Sign in →")</button>
        <div class="auth-switch">@(register ? "Already have an account?" : "New to CalFit?") <button type="button" class="inline-link" @onclick="Toggle">@(register ? "Sign in" : "Create an account")</button></div>
    </form>
    <div class="auth-bottom"><button class="subtle-link" @onclick="ToggleConnection">⚙ API connection settings</button>
        @if (showConnection)
        {
            <div class="connection-card">
                <label class="field-label">Backend URL</label><input class="field" @bind="baseUrl" placeholder="http://10.0.2.2:5206/" />
                <div class="button-row"><button class="btn btn-secondary" @onclick="SaveUrl">Save address</button><button class="btn btn-outline" @onclick="TestUrl" disabled="@testing">@(testing ? "Testing…" : "Test connection")</button></div>
                <p class="small muted">Android emulator: 10.0.2.2. Physical phone over USB: 127.0.0.1 after <code>adb reverse tcp:5206 tcp:5206</code>. Wi-Fi: use your PC's LAN IP and a reachable API binding.</p>
                @if (!string.IsNullOrWhiteSpace(connectionMessage)) { <p class="small">@connectionMessage</p> }
            </div>
        }
    </div>
</div>
@code {
    private bool register, busy, showConnection, testing;
    private string name = "", email = "", password = "", confirm = "", error = "", success = "", connectionMessage = "";
    private string baseUrl = "";
    protected override void OnInitialized() => baseUrl = Api.BaseUrl;
    private void Toggle() { register = !register; error = ""; success = ""; password = ""; confirm = ""; }
    private void ToggleConnection() { showConnection = !showConnection; baseUrl = Api.BaseUrl; connectionMessage = ""; }
    private async Task SubmitAsync()
    {
        if (busy) return;
        error = ""; success = "";
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password)) { error = "Email and password are required."; return; }
        if (register && (string.IsNullOrWhiteSpace(name) || password.Length < 8 || password != confirm)) { error = "Enter your name, a password of at least 8 characters, and matching confirmation."; return; }
        busy = true;
        try
        {
            if (register) { await Api.RegisterAsync(name, email, password); register = false; password = ""; confirm = ""; success = "Account created. Sign in to continue."; }
            else await Session.SignInAsync(email, password);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
    private void SaveUrl()
    {
        try { Api.BaseUrl = baseUrl; baseUrl = Api.BaseUrl; connectionMessage = "Address saved. Test the connection, then sign in."; }
        catch (Exception ex) { connectionMessage = ex.Message; }
    }
    private async Task TestUrl()
    {
        try
        {
            Api.BaseUrl = baseUrl;
            testing = true;
            connectionMessage = await Api.PingAsync() ? "✓ Backend reachable." : "Could not reach the backend. Check port, Android routing, firewall and server status.";
        }
        catch (Exception ex) { connectionMessage = ex.Message; }
        finally { testing = false; }
    }
}
