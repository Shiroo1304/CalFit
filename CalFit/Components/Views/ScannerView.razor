@using System.Globalization
@using System.Net
@using System.Net.Http
@using System.Net.Sockets
@using Microsoft.Maui.Storage
@using Microsoft.JSInterop
@using CalFit.Services
@using CalFit.Models
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject CalFitApi Api
@inject AuthSession Session
@inject MealNotesService Notes
@inject Esp32CameraService Esp32Camera

<div class="screen" @ref="scannerElement">
    <header class="page-heading">
        <div>
            <span class="eyebrow">SMART NUTRITION</span>
            <h1>Food scanner<span class="accent">.</span></h1>
            <p>Preview, capture, analyze and log.</p>
        </div>
    </header>

    <div class="surface form-surface" style="margin-bottom:16px">
        <h2 style="margin-top:0">ESP32-CAM</h2>

        <div class="scanner-feature"
             aria-label="ESP32 camera live preview">

            @if (livePreview)
            {
                @if (!string.IsNullOrWhiteSpace(previewFrame))
                {
                    <img class="food-preview"
                         src="@previewFrame"
                         alt="ESP32-CAM live stream" />
                }
                else
                {
                    <div class="scanner-illustration">
                        <div class="lens">◉</div>
                        <strong>Connecting to camera…</strong>
                    </div>
                }

                <span style="position:absolute;top:12px;left:12px;
                    z-index:3;padding:7px 10px;
                    border-radius:8px;background:#07130f;
                    color:#9af7c5;font-size:11px">
                    LIVE · ESP32-CAM
                </span>
            }
            else
            {
                <div class="scanner-illustration">
                    <div class="lens">◉</div>
                    <strong>ESP32-CAM live preview</strong>
                    <p>
                        Open camera settings below to configure
                        and start your camera.
                    </p>
                </div>
            }

            <span class="scanner-corner top-left"></span>
            <span class="scanner-corner top-right"></span>
            <span class="scanner-corner bottom-left"></span>
            <span class="scanner-corner bottom-right"></span>
        </div>

        <div class="button-row photo-actions">
            <button type="button"
                    class="btn btn-primary full"
                    @onclick="CaptureEsp32Async"
                    disabled="@busy">
                @(capturingEsp32
                    ? "Capturing image…"
                    : "◎ Capture image")
            </button>
        </div>

        <div class="button-row esp32-motors">
            <button type="button"
                    class="btn btn-outline"
                    data-motor="forward"
                    disabled="@(!motorReady || busy || showMealPopup)">
                ↑ Up
            </button>

            <button type="button"
                    class="btn btn-outline"
                    data-motor="backward"
                    disabled="@(!motorReady || busy || showMealPopup)">
                ↓ Down
            </button>
        </div>

        <p class="small muted" role="status">
            @motorStatus
        </p>

        <details style="margin-top:16px;
            border-top:1px solid var(--surface-border);
            padding-top:16px">

            <summary style="cursor:pointer;color:var(--accent);
                font-weight:700">
                Camera settings
            </summary>

            <label class="field-label" for="camera-ip">
                ESP32-CAM IP address
            </label>

            <input id="camera-ip"
                   class="field"
                   placeholder="Enter IP from Serial Monitor"
                   @bind="cameraIp"
                   disabled="@busy" />

            <label class="field-label" for="camera-stream">
                Live stream URL
            </label>

            <input id="camera-stream"
                   class="field"
                   placeholder="http://YOUR_ESP32_IP:81/stream"
                   @bind="streamUrl"
                   disabled="@(busy || livePreview)" />

            <p class="small muted">
                Use the IP assigned to the ESP32 by your phone hotspot.
                Leave the stream URL blank to generate it from that IP.
            </p>

            <div class="button-row photo-actions">
                <button type="button"
                        class="btn btn-outline"
                        @onclick="StartPreview"
                        disabled="@(busy || livePreview)">
                    Start live preview
                </button>

                <button type="button"
                        class="btn btn-outline"
                        @onclick="StopPreviewAsync"
                        disabled="@(!livePreview)">
                    Stop preview
                </button>
            </div>
        </details>
    </div>

    <div class="scanner-tip">
        <span>✧</span>
        Capture your meal, review its details, then save it to your journal.
    </div>

    @if (!showMealPopup && !string.IsNullOrWhiteSpace(message))
    {
        <div class="notice @(hasError ? "error" : "success")"
             role="status">
            @message
        </div>
    }

    <div class="button-row photo-actions">
        <button type="button"
                class="btn btn-outline full"
                @onclick="OpenMealPopup"
                disabled="@busy">
            @(string.IsNullOrWhiteSpace(photoPath)
                ? "＋ Enter meal manually"
                : "Review captured meal")
        </button>
    </div>

    @if (showMealPopup)
    {
        <div class="meal-popup-overlay" @onclick="CloseMealPopup">
            <section class="meal-popup"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="meal-popup-title"
                     tabindex="0"
                     @onkeydown="PopupKeyDown"
                     @onclick:stopPropagation="true">

                <header class="meal-popup-header"
                        @ontouchstart="PopupTouchStart"
                        @ontouchend="PopupTouchEnd"
                        @ontouchcancel="CancelPopupSwipe">

                    <div class="meal-popup-handle"></div>

                    <div class="modal-top">
                        <div>
                            <span class="eyebrow">REVIEW YOUR PLATE</span>
                            <h2 id="meal-popup-title">Meal details</h2>
                        </div>

                        <button type="button"
                                class="icon-button"
                                aria-label="Close meal details"
                                @onclick="CloseMealPopup">
                            ✕
                        </button>
                    </div>

                    <p class="small muted">
                        Swipe this header left or right to close.
                        Your draft will be kept.
                    </p>
                </header>

                <div class="meal-popup-content">
                    @if (!string.IsNullOrWhiteSpace(previewData))
                    {
                        <img class="meal-popup-photo"
                             src="@previewData"
                             alt="Captured meal" />
                    }

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="notice @(hasError ? "error" : "success")"
                             role="status">
                            @message
                        </div>
                    }

                    <div class="section-head">
                        <h3>Review your plate</h3>

                        <button type="button"
                                class="text-link"
                                @onclick="Clear"
                                disabled="@busy">
                            Reset ↻
                        </button>
                    </div>

                    <label class="field-label" for="food-name">
                        Food name
                    </label>

                    <input id="food-name"
                           class="field"
                           placeholder="e.g. Chicken adobo with rice"
                           @bind="foodName"
                           disabled="@busy" />

                    <div class="two-col">
                        <div>
                            <label class="field-label" for="meal-type">
                                Meal type
                            </label>

                            <select id="meal-type"
                                    class="field"
                                    @bind="mealType"
                                    disabled="@busy">
                                <option>Breakfast</option>
                                <option>Lunch</option>
                                <option>Dinner</option>
                                <option>Snack</option>
                            </select>
                        </div>

                        <div>
                            <label class="field-label" for="food-weight">
                                Weight (g) · verify AI estimate
                            </label>

                            <input id="food-weight"
                                   class="field"
                                   type="number"
                                   min="0"
                                   step="0.1"
                                   placeholder="Enter weight in grams"
                                   @bind="weight"
                                   disabled="@busy" />
                        </div>
                    </div>

                    <button type="button"
                            class="btn btn-ai full"
                            style="margin-top:16px"
                            @onclick="AnalyzeAsync"
                            disabled="@(busy || string.IsNullOrWhiteSpace(photoPath))">
                        @(analyzing
                            ? "Analyzing your food…"
                            : "✦ Analyze with CalFit AI")
                    </button>

                    <div class="two-col">
                        <div>
                            <label class="field-label" for="food-calories">
                                Calories (kcal)
                            </label>

                            <input id="food-calories"
                                   class="field"
                                   type="number"
                                   min="1"
                                   step="1"
                                   @bind="calories"
                                   disabled="@busy" />
                        </div>

                        <div>
                            <label class="field-label" for="food-protein">
                                Protein (g)
                            </label>

                            <input id="food-protein"
                                   class="field"
                                   type="number"
                                   min="0"
                                   step="0.1"
                                   @bind="protein"
                                   disabled="@busy" />
                        </div>

                        <div>
                            <label class="field-label" for="food-carbs">
                                Carbs (g)
                            </label>

                            <input id="food-carbs"
                                   class="field"
                                   type="number"
                                   min="0"
                                   step="0.1"
                                   @bind="carbs"
                                   disabled="@busy" />
                        </div>

                        <div>
                            <label class="field-label" for="food-fat">
                                Fat (g)
                            </label>

                            <input id="food-fat"
                                   class="field"
                                   type="number"
                                   min="0"
                                   step="0.1"
                                   @bind="fat"
                                   disabled="@busy" />
                        </div>
                    </div>

                    <label class="field-label" for="food-ingredients">
                        Ingredients (optional)
                    </label>

                    <textarea id="food-ingredients"
                              class="field textarea"
                              rows="2"
                              placeholder="List ingredients and quantities."
                              @bind="ingredients"
                              disabled="@busy"></textarea>

                    <label class="field-label" for="food-notes">
                        Notes (optional)
                    </label>

                    <textarea id="food-notes"
                              class="field textarea"
                              rows="2"
                              placeholder="Your own meal notes"
                              @bind="notes"
                              disabled="@busy"></textarea>
                </div>

                <footer class="meal-popup-footer">
                    <button type="button"
                            class="btn btn-primary full"
                            @onclick="SaveAsync"
                            disabled="@busy">
                        @(saving
                            ? "Saving meal…"
                            : "Save to my food journal →")
                    </button>
                </footer>
            </section>
        </div>
    }

    <div class="bottom-whitespace"></div>
</div>

@code {
    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OpenDevice { get; set; }

    private ElementReference scannerElement;

    private IJSObjectReference? motorModule;
    private IJSObjectReference? motorBinding;
    private DotNetObjectReference<ScannerView>? motorReference;

    private readonly HttpClient cameraClient = new()
    {
        Timeout = TimeSpan.FromSeconds(20)
    };

    private readonly HttpClient motorClient = new()
    {
        Timeout = TimeSpan.FromSeconds(2)
    };

    private readonly SemaphoreSlim motorGate = new(1, 1);
    private readonly CancellationTokenSource lifetime = new();

    private string cameraIp = "";
    private string streamUrl = "";

    private string? previewFrame;
    private CancellationTokenSource? previewCancellation;
    private Task? previewTask;

    private string? motorHost;

    private string motorStatus =
        "Hold Up or Down to move. Release to stop.";

    private string foodName = "";
    private string mealType = "Lunch";
    private string weight = "";
    private string calories = "";
    private string protein = "";
    private string carbs = "";
    private string fat = "";
    private string ingredients = "";
    private string notes = "";
    private string message = "";

    private string? photoPath;
    private string? previewData;

    private bool livePreview;
    private bool motorReady;
    private bool busy;
    private bool analyzing;
    private bool saving;
    private bool hasError;
    private bool capturingEsp32;
    private bool disposed;

    private bool showMealPopup;
    private bool popupSwipeStarted;
    private double popupTouchX;
    private double popupTouchY;

    private int fileRevision;
    private long latestMotorCommand;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed)
            return;

        try
        {
            motorModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/esp32-controls.js"
            );

            if (disposed)
            {
                await motorModule.DisposeAsync();
                return;
            }

            motorReference = DotNetObjectReference.Create(this);

            motorBinding = await motorModule.InvokeAsync<IJSObjectReference>(
                "bind",
                scannerElement,
                motorReference
            );

            motorReady = !disposed;

            if (!disposed)
                await InvokeAsync(StateHasChanged);
        }
        catch (JSException ex)
        {
            motorStatus = "Motor controls could not load: " + ex.Message;

            if (!disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    // =====================================
    // MOTOR CONTROL
    // =====================================

    [JSInvokable]
    public async Task MotorCommand(string direction, long sequence)
    {
        if (disposed || sequence <= latestMotorCommand)
            return;

        latestMotorCommand = sequence;

        await motorGate.WaitAsync();

        try
        {
            if (disposed || sequence != latestMotorCommand)
                return;

            if (direction is not ("forward" or "backward" or "stop"))
                return;

            if (direction != "stop")
            {
                if (busy || showMealPopup)
                    return;

                if (!TryGetCameraAddress(out var address))
                {
                    throw new InvalidOperationException(
                        "Enter the ESP32's private IPv4 address."
                    );
                }

                // Release must stop the same device that was started.
                motorHost ??= address.ToString();
            }

            if (motorHost == null)
                return;

            await SendMotorRequestAsync(motorHost, direction);

            if (direction == "stop")
                motorHost = null;
        }
        catch (Exception ex)
        {
            if (!disposed)
            {
                motorStatus = $"Motor {direction} at {motorHost}: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }

            throw;
        }
        finally
        {
            motorGate.Release();
        }
    }

    private async Task SendMotorRequestAsync(
    string host,
    string direction)
    {
        using var request = new HttpRequestMessage(
            HttpMethod.Get,
            $"http://{host}/control?direction={direction}"
        );

        request.Version = HttpVersion.Version11;
        request.VersionPolicy =
            HttpVersionPolicy.RequestVersionExact;

        request.Headers.ConnectionClose = true;

        request.Headers.TryAddWithoutValidation(
            "Cache-Control",
            "no-cache"
        );

        using var response = await motorClient.SendAsync(request);

        if (!response.IsSuccessStatusCode)
        {
            string detail =
                await response.Content.ReadAsStringAsync();

            throw new HttpRequestException(
                $"HTTP {(int)response.StatusCode}: {detail}"
            );
        }
    }

    private async Task StopMotorAsync()
    {
        if (motorBinding == null)
            return;

        try
        {
            await motorBinding.InvokeVoidAsync("stop");
        }
        catch (JSException)
        {
            // The firmware timeout remains the independent fallback.
        }
    }

    // =====================================
    // NATIVE LIVE PREVIEW
    // =====================================

    private async Task StartPreview()
    {
        if (busy || disposed)
            return;

        string requestedUrl = streamUrl.Trim();

        if (string.IsNullOrWhiteSpace(requestedUrl)
            && TryGetCameraAddress(out var cameraAddress))
        {
            requestedUrl = $"http://{cameraAddress}:81/stream";
            streamUrl = requestedUrl;
        }

        if (!Uri.TryCreate(
                requestedUrl,
                UriKind.Absolute,
                out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp
                && uri.Scheme != Uri.UriSchemeHttps)
            || !IPAddress.TryParse(uri.Host, out var address)
            || address.AddressFamily != AddressFamily.InterNetwork
            || !IsPrivateIpv4(address))
        {
            Show("Enter a valid private IPv4 camera stream URL.", true);
            return;
        }

        await StopPreviewAsync();

        if (disposed)
            return;

        message = "";
        previewFrame = null;
        livePreview = true;

        var cancellation =
            CancellationTokenSource.CreateLinkedTokenSource(
                lifetime.Token
            );

        previewCancellation = cancellation;

        previewTask = RunPreviewAsync(
            uri.AbsoluteUri,
            cancellation
        );
    }

    private async Task RunPreviewAsync(
        string url,
        CancellationTokenSource cancellation)
    {
        CancellationToken token = cancellation.Token;

        try
        {
            await Esp32Camera.ReadPreviewAsync(
                url,
                async frame =>
                {
                    string image =
                        "data:image/jpeg;base64,"
                        + Convert.ToBase64String(frame);

                    await InvokeAsync(() =>
                    {
                        if (disposed
                            || token.IsCancellationRequested
                            || previewCancellation != cancellation)
                        {
                            return;
                        }

                        previewFrame = image;
                        StateHasChanged();
                    });
                },
                token
            );
        }
        catch (OperationCanceledException)
            when (token.IsCancellationRequested)
        {
            // Normal stop, capture, or navigation.
        }
        catch (Exception ex)
        {
            if (!disposed && !token.IsCancellationRequested)
            {
                await InvokeAsync(() =>
                {
                    if (previewCancellation != cancellation)
                        return;

                    livePreview = false;
                    previewFrame = null;

                    Show(
                        "Live preview failed: " + ex.Message,
                        true
                    );

                    StateHasChanged();
                });

                await StopMotorAsync();
            }
        }
        finally
        {
            if (previewCancellation == cancellation)
                previewCancellation = null;

            cancellation.Dispose();
        }
    }

    private async Task StopPreviewAsync()
    {
        Task? previousTask = previewTask;
        previewTask = null;

        var cancellation = previewCancellation;
        previewCancellation = null;

        livePreview = false;
        previewFrame = null;

        cancellation?.Cancel();

        if (previousTask != null)
            await previousTask;
    }

    // =====================================
    // MEAL POPUP
    // =====================================

    private async Task OpenMealPopup()
    {
        if (disposed)
            return;

        await StopMotorAsync();

        if (!disposed)
            showMealPopup = true;
    }

    private void CloseMealPopup()
    {
        showMealPopup = false;
        popupSwipeStarted = false;
    }

    private void PopupKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseMealPopup();
    }

    private void PopupTouchStart(TouchEventArgs e)
    {
        popupSwipeStarted = e.Touches.Length == 1;

        if (!popupSwipeStarted)
            return;

        popupTouchX = e.Touches[0].ClientX;
        popupTouchY = e.Touches[0].ClientY;
    }

    private void PopupTouchEnd(TouchEventArgs e)
    {
        if (!popupSwipeStarted || e.ChangedTouches.Length == 0)
            return;

        popupSwipeStarted = false;

        double distanceX =
            e.ChangedTouches[0].ClientX - popupTouchX;

        double distanceY =
            e.ChangedTouches[0].ClientY - popupTouchY;

        if (Math.Abs(distanceX) >= 80
            && Math.Abs(distanceX) > Math.Abs(distanceY) * 1.5)
        {
            CloseMealPopup();
        }
    }

    private void CancelPopupSwipe(TouchEventArgs e)
    {
        popupSwipeStarted = false;
    }

    // =====================================
    // CAMERA ADDRESS VALIDATION
    // =====================================

    private bool TryGetCameraAddress(out IPAddress address)
    {
        address = IPAddress.None;

        if (!IPAddress.TryParse(cameraIp.Trim(), out var parsed)
            || parsed.AddressFamily != AddressFamily.InterNetwork
            || !IsPrivateIpv4(parsed))
        {
            return false;
        }

        address = parsed;
        return true;
    }

    private static bool IsPrivateIpv4(IPAddress address)
    {
        byte[] bytes = address.GetAddressBytes();

        return bytes[0] == 10
            || (bytes[0] == 172
                && bytes[1] >= 16
                && bytes[1] <= 31)
            || (bytes[0] == 192 && bytes[1] == 168);
    }

    // =====================================
    // CAPTURE
    // =====================================

    private async Task CaptureEsp32Async()
    {
        if (busy || disposed)
            return;

        if (!TryGetCameraAddress(out var address))
        {
            Show("Enter a valid private IPv4 camera address.", true);
            return;
        }

        busy = true;
        capturingEsp32 = true;
        message = "";

        string? pendingPath = null;

        try
        {
            await StopMotorAsync();
            await StopPreviewAsync();

            await InvokeAsync(StateHasChanged);
            await Task.Delay(200, lifetime.Token);

            using var response = await cameraClient.GetAsync(
                $"http://{address}/capture?t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
                lifetime.Token
            );

            response.EnsureSuccessStatusCode();

            byte[] image =
                await response.Content.ReadAsByteArrayAsync(
                    lifetime.Token
                );

            if (image.Length == 0
                || image.Length > 10 * 1024 * 1024)
            {
                Show(
                    "Camera image is empty or exceeds 10 MB.",
                    true
                );
                return;
            }

            if (image.Length < 4
                || image[0] != 0xFF
                || image[1] != 0xD8
                || image[^2] != 0xFF
                || image[^1] != 0xD9)
            {
                Show(
                    "Camera did not return a complete JPEG image.",
                    true
                );
                return;
            }

            pendingPath = Path.Combine(
                FileSystem.CacheDirectory,
                $"calfit_esp32_{Guid.NewGuid():N}.jpg"
            );

            await File.WriteAllBytesAsync(
                pendingPath,
                image,
                lifetime.Token
            );

            if (disposed)
                return;

            Clear();

            photoPath = pendingPath;
            pendingPath = null;

            previewData =
                "data:image/jpeg;base64,"
                + Convert.ToBase64String(image);

            fileRevision++;
            showMealPopup = true;

            Show(
                "Image captured. Enter weight or analyze to estimate it.",
                false
            );
        }
        catch (OperationCanceledException) when (disposed)
        {
        }
        catch (OperationCanceledException)
        {
            Show(
                "Camera capture timed out. Check the Wi-Fi connection.",
                true
            );
        }
        catch (Exception ex)
        {
            Show(
                "ESP32-CAM capture failed: " + ex.Message,
                true
            );
        }
        finally
        {
            DeleteCachedPhoto(pendingPath);

            capturingEsp32 = false;
            busy = false;

            if (disposed)
                DeleteCachedPhoto(photoPath);
        }
    }

    // =====================================
    // AI ANALYSIS
    // =====================================

    private static double Parse(string input)
    {
        if (double.TryParse(
                input,
                NumberStyles.Float,
                CultureInfo.InvariantCulture,
                out double value))
        {
            return value;
        }

        return double.TryParse(
                input,
                NumberStyles.Float,
                CultureInfo.CurrentCulture,
                out value)
            ? value
            : double.NaN;
    }

    private async Task AnalyzeAsync()
    {
        if (busy || disposed || photoPath == null)
            return;

        busy = true;
        analyzing = true;
        message = "";

        int version = fileRevision;

        try
        {
            double grams = Parse(weight);

            var result = await Api.AnalyzeAsync(
                Session.Token!,
                photoPath,
                grams > 0 && double.IsFinite(grams)
                    ? grams
                    : null
            );

            if (disposed || version != fileRevision)
                return;

            if (!result.IsFood)
            {
                Show(
                    "The image does not appear to contain food.",
                    true
                );
                return;
            }

            foodName = result.FoodName;

            if (string.IsNullOrWhiteSpace(weight)
                && double.IsFinite(result.WeightGrams)
                && result.WeightGrams > 0)
            {
                weight = result.WeightGrams.ToString(
                    "0.#",
                    CultureInfo.InvariantCulture
                );
            }

            calories = result.Calories.ToString(
                CultureInfo.InvariantCulture
            );

            protein = result.ProteinGrams.ToString(
                CultureInfo.InvariantCulture
            );

            carbs = result.CarbsGrams.ToString(
                CultureInfo.InvariantCulture
            );

            fat = result.FatGrams.ToString(
                CultureInfo.InvariantCulture
            );

            if (!string.IsNullOrWhiteSpace(result.Notes))
                notes = result.Notes;

            Show(
                "AI estimate ready. Verify weight and nutrition before saving.",
                false
            );
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
            analyzing = false;

            if (disposed)
                DeleteCachedPhoto(photoPath);
        }
    }

    // =====================================
    // SAVE TO JOURNAL
    // =====================================

    private async Task SaveAsync()
    {
        if (busy || disposed)
            return;

        double grams = string.IsNullOrWhiteSpace(weight)
            ? 0 : Parse(weight);

        double p = string.IsNullOrWhiteSpace(protein)
            ? 0 : Parse(protein);

        double c = string.IsNullOrWhiteSpace(carbs)
            ? 0 : Parse(carbs);

        double f = string.IsNullOrWhiteSpace(fat)
            ? 0 : Parse(fat);

        if (string.IsNullOrWhiteSpace(foodName)
            || !int.TryParse(calories, out int kcal)
            || kcal <= 0
            || !double.IsFinite(grams) || grams < 0
            || !double.IsFinite(p) || p < 0
            || !double.IsFinite(c) || c < 0
            || !double.IsFinite(f) || f < 0)
        {
            Show(
                "Enter a food name, positive calories, and valid non-negative weight and macros.",
                true
            );
            return;
        }

        busy = true;
        saving = true;
        message = "";

        bool savedToServer = false;

        try
        {
            var saved = await Api.SaveMealAsync(
                Session.Token!,
                new Meal
                {
                    FoodName = foodName.Trim(),
                    MealType = mealType,
                    WeightGrams = grams,
                    Calories = kcal,
                    ProteinGrams = p,
                    CarbsGrams = c,
                    FatGrams = f
                }
            );

            savedToServer = true;

            try
            {
                if (!string.IsNullOrWhiteSpace(ingredients)
                    || !string.IsNullOrWhiteSpace(notes))
                {
                    Notes.Save(
                        saved.UserId,
                        saved.Id,
                        new()
                        {
                            Ingredients = ingredients,
                            Note = notes
                        }
                    );
                }
            }
            catch
            {
                Clear();

                Show(
                    "Meal saved, but its local notes could not be stored.",
                    true
                );

                return;
            }

            Clear();
            CloseMealPopup();

            if (!disposed)
                await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Show(
                savedToServer
                    ? "Meal was saved, but the screen could not update: "
                        + ex.Message
                    : "Could not save meal: " + ex.Message,
                true
            );
        }
        finally
        {
            busy = false;
            saving = false;

            if (disposed)
                DeleteCachedPhoto(photoPath);
        }
    }

    // =====================================
    // DRAFT / CACHE
    // =====================================

    private void Show(string text, bool failure)
    {
        if (disposed)
            return;

        message = text;
        hasError = failure;
    }

    private void Clear()
    {
        foodName = "";
        mealType = "Lunch";
        weight = "";
        calories = "";
        protein = "";
        carbs = "";
        fat = "";
        ingredients = "";
        notes = "";

        message = "";
        hasError = false;
        previewData = null;

        fileRevision++;

        DeleteCachedPhoto(photoPath);
        photoPath = null;
    }

    private static void DeleteCachedPhoto(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return;

        try
        {
            File.Delete(path);
        }
        catch (IOException)
        {
        }
        catch (UnauthorizedAccessException)
        {
        }
    }

    // =====================================
    // CLEANUP
    // =====================================

    public async ValueTask DisposeAsync()
    {
        if (disposed)
            return;

        disposed = true;
        motorReady = false;
        fileRevision++;

        lifetime.Cancel();

        try
        {
            if (motorBinding != null)
                await motorBinding.InvokeVoidAsync("dispose");
        }
        catch (JSException)
        {
        }

        await motorGate.WaitAsync();

        try
        {
            if (motorHost != null)
                await SendMotorRequestAsync(motorHost, "stop");
        }
        catch (HttpRequestException)
        {
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            motorGate.Release();
            motorClient.Dispose();
        }

        await StopPreviewAsync();

        cameraClient.Dispose();

        if (!busy)
            DeleteCachedPhoto(photoPath);

        lifetime.Dispose();
        motorReference?.Dispose();

        try
        {
            if (motorBinding != null)
                await motorBinding.DisposeAsync();

            if (motorModule != null)
                await motorModule.DisposeAsync();
        }
        catch (JSException)
        {
        }
    }
}