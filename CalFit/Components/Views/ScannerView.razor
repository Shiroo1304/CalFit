@using System.Globalization
@using CalFit.Models
@using CalFit.Services
@using Microsoft.Maui.Storage
@implements IAsyncDisposable

@inject CalFitApi Api
@inject AuthSession Session
@inject MealNotesService Notes
@inject CalFitBotSession BotSession
@inject ICalFitBotService Robot
@inject ICalFitBotAddressStore RobotAddress

<div class="screen">
    <header class="page-heading">
        <div>
            <span class="eyebrow">SMART NUTRITION</span>
            <h1>Food scanner<span class="accent">.</span></h1>
            <p>Your robot captures. You review and track.</p>
        </div>
    </header>

    <div class="surface form-surface bot-receiver">
        <div class="modal-top"><h2>CalFitBot</h2><span class="bot-state">@ConnectionLabel</span></div>
        <p class="small muted" role="status" aria-live="polite">@BotSession.Message</p>
        @if (BotSession.Address != null)
        {
            <p class="small muted">Connected to @BotSession.Address.Authority</p>
        }
        <div class="scanner-feature bot-photo-viewer">
            @if (!string.IsNullOrWhiteSpace(previewData))
            {
                <img class="food-preview" src="@previewData" alt="Food photo received from CalFitBot" />
            }
            else
            {
                <div class="scanner-illustration">
                    <div class="lens">▧</div><strong>@ViewerTitle</strong>
                    <p>Capture and press SUBMIT on the robot touchscreen. The photo and weight will appear here.</p>
                </div>
            }
        </div>
        <div class="bot-weight-summary">
            <div><small>CAPTURED WEIGHT</small><strong>@CapturedWeightText</strong></div>
            <div><small>LIVE SCALE</small><span>@LiveWeightText</span></div>
        </div>
        <p class="small muted">Analysis uses the captured weight, not a later live scale reading.</p>
        @if (BotSession.Receipt is { Acknowledged: false, Canceled: false })
        {
            <div class="notice info">Photo and weight are stored locally. Waiting for robot acknowledgement before analysis.</div>
        }
        @if (BotSession.Receipt is { Canceled: true })
        {
            <div class="notice error">This scan was not confirmed. Submit a new scan on the robot.</div>
        }
        <div class="button-row photo-actions">
            <button type="button" class="btn btn-primary" disabled="@(!CanAnalyze)" @onclick="AnalyzeAsync">@(analyzing ? "Analyzing…" : "✦ Analyze Food")</button>
            <button type="button" class="btn btn-outline" disabled="@(busy || !BotSession.CanAnalyze || savedScanId == draftScanId)" @onclick="OpenMealPopup">Review meal</button>
        </div>
        @if (BotSession.Receipt != null)
        {
            <button type="button" class="subtle-link" disabled="@(busy || connecting)" @onclick="DiscardReceipt">Discard received draft</button>
        }
        <details class="bot-connection-settings">
            <summary>Robot connection</summary>
            <label class="field-label" for="robot-address">Manual IP address (optional)</label>
            <input id="robot-address" class="field" @bind="manualAddress" placeholder="calfitbot.local or robot IP" disabled="@(connecting || busy)" />
            <p class="small muted">The robot joins your phone hotspot. Leave this blank for automatic discovery. Only successfully verified addresses are remembered.</p>
            <div class="button-row">
                <button type="button" class="btn btn-outline" disabled="@(connecting || busy)" @onclick="Reconnect">@(connecting ? "Connecting…" : "Connect / reconnect")</button>
                <button type="button" class="btn btn-outline" disabled="@(connecting || busy)" @onclick="Retry">Retry transfer</button>
            </div>
        </details>
    </div>

    @if (!showMealPopup && !string.IsNullOrWhiteSpace(message))
    {
        <div class="notice @(hasError ? "error" : "success")" role="status">@message</div>
    }

    @if (IsSimulation)
    {
        <details class="surface form-surface bot-simulation" open>
            <summary>Development simulator · no physical robot</summary>
            <label class="field-label" for="mock-weight">Simulated weight (g)</label>
            <input id="mock-weight" class="field" type="number" min="0" step="0.1" @bind="simulationWeight" />
            <label class="field-label" for="mock-scenario">Next submission</label>
            <select id="mock-scenario" class="field" @bind="simulationScenario">
                <option value="Normal">Successful transfer</option>
                <option value="MissingWeight">Unavailable captured weight</option>
                <option value="PhotoFailures">Photo fails twice, then succeeds</option>
                <option value="CanceledScan">Canceled before photo arrives</option>
                <option value="AcknowledgementFailures">Acknowledgement fails twice</option>
                <option value="WrongPhotoSize">Photo size mismatch</option>
            </select>
            <div class="button-row photo-actions">
                <button class="btn btn-outline" @onclick="SimulateSubmit" disabled="@busy">Submit sample meal</button>
                <button class="btn btn-outline" @onclick="SimulateDuplicate" disabled="@busy">Replay duplicate</button>
            </div>
            <div class="button-row photo-actions">
                <button class="btn btn-outline" @onclick="SimulateConnection">Connect / disconnect</button>
                <button class="btn btn-outline" @onclick="SimulateStandby">Toggle standby</button>
                <button class="btn btn-outline" @onclick="SimulateTimeout">Toggle timeout</button>
            </div>
            <p class="small muted">These controls and the sample illustration are available only in a simulation-enabled Debug build. AI still uses your real backend.</p>
        </details>
    }

    @if (showMealPopup)
    {
        <div class="meal-popup-overlay" @onclick="CloseMealPopup">
            <section class="meal-popup"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="meal-popup-title"
                     tabindex="0"
                     @onkeydown="PopupKeyDown"
                     @onclick:stopPropagation="true">

                <header class="meal-popup-header"
                        @ontouchstart="PopupTouchStart"
                        @ontouchend="PopupTouchEnd"
                        @ontouchcancel="CancelPopupSwipe">

                    <div class="meal-popup-handle"></div>

                    <div class="modal-top">
                        <div>
                            <span class="eyebrow">REVIEW YOUR PLATE</span>
                            <h2 id="meal-popup-title">Meal details</h2>
                        </div>

                        <button type="button"
                                class="icon-button"
                                aria-label="Close meal details"
                                @onclick="CloseMealPopup">
                            ✕
                        </button>
                    </div>

                    <p class="small muted">
                        Swipe this header left or right to close.
                        Your draft will be kept.
                    </p>
                </header>

                <div class="meal-popup-content">
                    @if (!string.IsNullOrWhiteSpace(previewData))
                    {
                        <img class="meal-popup-photo"
                             src="@previewData"
                             alt="Captured meal" />
                    }

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="notice @(hasError ? "error" : "success")"
                             role="status">
                            @message
                        </div>
                    }

                    <div class="section-head">
                        <h3>Review your plate</h3>

                        <button type="button"
                                class="text-link"
                                @onclick="ResetNutrition"
                                disabled="@busy">
                            Reset ↻
                        </button>
                    </div>

                    <label class="field-label" for="food-name">
                        Food name
                    </label>

                    <input id="food-name"
                           class="field"
                           placeholder="e.g. Chicken adobo with rice"
                           @bind="foodName"
                           disabled="@busy" />

                    <div class="two-col">
                        <div>
                            <label class="field-label" for="meal-type">
                                Meal type
                            </label>

                            <select id="meal-type"
                                    class="field"
                                    @bind="mealType"
                                    disabled="@busy">
                                <option>Breakfast</option>
                                <option>Lunch</option>
                                <option>Dinner</option>
                                <option>Snack</option>
                            </select>
                        </div>

                        <div>
                            <label class="field-label" for="food-weight">
                                Weight (g) · robot measurement
                            </label>

                            <input id="food-weight"
                                   class="field"
                                   type="number"
                                   min="0"
                                   step="0.1"
                                   placeholder="Unavailable · enter manually if known"
                                   @bind="weight"
                                   disabled="@(busy || BotSession.Receipt?.Scan.WeightGrams != null)" />
                        </div>
                    </div>

                    <button type="button"
                            class="btn btn-ai full"
                            style="margin-top:16px"
                            @onclick="AnalyzeAsync"
                            disabled="@(!CanAnalyze)">
                        @(analyzing
                            ? "Analyzing your food…"
                            : "✦ Analyze with CalFit AI")
                    </button>

                    <div class="two-col">
                        <div>
                            <label class="field-label" for="food-calories">
                                Calories (kcal)
                            </label>

                            <input id="food-calories"
                                   class="field"
                                   type="number"
                                   min="1"
                                   step="1"
                                   @bind="calories"
                                   disabled="@busy" />
                        </div>

                        <div>
                            <label class="field-label" for="food-protein">
                                Protein (g)
                            </label>

                            <input id="food-protein"
                                   class="field"
                                   type="number"
                                   min="0"
                                   step="0.1"
                                   @bind="protein"
                                   disabled="@busy" />
                        </div>

                        <div>
                            <label class="field-label" for="food-carbs">
                                Carbs (g)
                            </label>

                            <input id="food-carbs"
                                   class="field"
                                   type="number"
                                   min="0"
                                   step="0.1"
                                   @bind="carbs"
                                   disabled="@busy" />
                        </div>

                        <div>
                            <label class="field-label" for="food-fat">
                                Fat (g)
                            </label>

                            <input id="food-fat"
                                   class="field"
                                   type="number"
                                   min="0"
                                   step="0.1"
                                   @bind="fat"
                                   disabled="@busy" />
                        </div>
                    </div>

                    <label class="field-label" for="food-ingredients">
                        Ingredients (optional)
                    </label>

                    <textarea id="food-ingredients"
                              class="field textarea"
                              rows="2"
                              placeholder="List ingredients and quantities."
                              @bind="ingredients"
                              disabled="@busy"></textarea>

                    <label class="field-label" for="food-notes">
                        Notes (optional)
                    </label>

                    <textarea id="food-notes"
                              class="field textarea"
                              rows="2"
                              placeholder="Your own meal notes"
                              @bind="notes"
                              disabled="@busy"></textarea>
                </div>

                <footer class="meal-popup-footer">
                    <button type="button"
                            class="btn btn-primary full"
                            @onclick="SaveAsync"
                            disabled="@(busy || !BotSession.CanAnalyze || savedScanId == draftScanId)">
                        @(saving
                            ? "Saving meal…"
                            : "Save to my food journal →")
                    </button>
                </footer>
            </section>
        </div>
    }

    <div class="bottom-whitespace"></div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OpenDevice { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private readonly SemaphoreSlim receiptViewGate = new(1, 1);
    private string manualAddress = "", message = "", foodName = "", mealType = "Lunch", weight = "";
    private string calories = "", protein = "", carbs = "", fat = "", ingredients = "", notes = "";
    private string? photoPath, previewData, draftScanId, loadingScanId, savedScanId;
    private bool busy, analyzing, saving, hasError, disposed, connecting, showMealPopup, popupSwipeStarted;
    private double popupTouchX, popupTouchY;
    private double simulationWeight = 385;
    private string simulationScenario = "Normal";
    private bool CanAnalyze => !busy && BotSession.CanAnalyze && photoPath != null
        && draftScanId == BotSession.Receipt?.Scan.ScanId && savedScanId != draftScanId;
    private string ConnectionLabel => BotSession.State switch
    {
        CalFitBotConnectionState.Disconnected => "Disconnected",
        CalFitBotConnectionState.Discovering or CalFitBotConnectionState.Connecting => "Connecting",
        CalFitBotConnectionState.Receiving => "Receiving",
        CalFitBotConnectionState.Acknowledging => "Confirming",
        CalFitBotConnectionState.Error or CalFitBotConnectionState.RetryRequired => "Needs attention",
        _ => "Connected"
    };
    private string ViewerTitle => BotSession.State == CalFitBotConnectionState.Receiving ? "Receiving photo…" : "Waiting for robot submission";
    private string CapturedWeightText => BotSession.Receipt?.Scan.WeightGrams is double grams ? $"{grams:0.#} g" : "— g";
    private string LiveWeightText => BotSession.LiveWeight is double grams ? $"{grams:0.#} g" : "Unavailable";
    private bool IsSimulation
    {
        get
        {
#if DEBUG
            return Robot is MockCalFitBotService;
#else
            return false;
#endif
        }
    }

    protected override async Task OnInitializedAsync()
    {
        BotSession.Changed += OnRobotChanged;
        manualAddress = RobotAddress.LastAddress ?? "";
        try
        {
            if (Session.Profile == null) await Session.RefreshProfileAsync();
            if (Session.Profile == null) throw new InvalidOperationException("Sign in before receiving a robot scan.");
            await BotSession.StartAsync(Session.Profile.Id.ToString(CultureInfo.InvariantCulture), lifetime.Token);
            await UpdateReceiptAsync();
        }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception ex) { Show(ex.Message, true); }
    }

    private void OnRobotChanged()
    {
        if (!disposed) _ = InvokeAsync(UpdateReceiptAsync);
    }
    private async Task UpdateReceiptAsync()
    {
        if (disposed || !await receiptViewGate.WaitAsync(0, lifetime.Token)) return;
        try
        {
            var receipt = BotSession.Receipt;
            if (receipt == null)
            {
                if (draftScanId != null && !busy) ClearDraft();
            }
            else if (!receipt.Canceled && receipt.Scan.ScanId != draftScanId && receipt.Scan.ScanId != loadingScanId)
            {
                loadingScanId = receipt.Scan.ScanId;
                byte[] jpeg = await File.ReadAllBytesAsync(receipt.PhotoPath, lifetime.Token);
                if (disposed || BotSession.Receipt?.Scan.ScanId != receipt.Scan.ScanId) return;
                ClearDraft();
                draftScanId = receipt.Scan.ScanId;
                photoPath = receipt.PhotoPath;
                previewData = "data:image/jpeg;base64," + Convert.ToBase64String(jpeg);
                weight = receipt.Scan.WeightGrams?.ToString("0.#", CultureInfo.InvariantCulture) ?? "";
            }
        }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception ex) { Show("Unable to display the stored scan: " + ex.Message, true); }
        finally { loadingScanId = null; receiptViewGate.Release(); }
        if (!disposed) StateHasChanged();
    }

    private async Task Reconnect()
    {
        if (disposed) return;
        connecting = true;
        try { await BotSession.ReconnectAsync(manualAddress, lifetime.Token); }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { connecting = false; }
    }
    private async Task Retry()
    {
        if (disposed) return;
        connecting = true;
        try { await BotSession.RetryAsync(lifetime.Token); }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { connecting = false; }
    }
    private async Task DiscardReceipt()
    {
        if (busy) return;
        try
        {
            await BotSession.CompleteAsync(lifetime.Token);
            ClearDraft();
            showMealPopup = false;
        }
        catch (Exception ex) { if (!disposed) Show(ex.Message, true); }
    }

    private void OpenMealPopup() { if (BotSession.CanAnalyze) showMealPopup = true; }
    private void CloseMealPopup() { showMealPopup = false; popupSwipeStarted = false; }
    private void PopupKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseMealPopup(); }
    private void PopupTouchStart(TouchEventArgs e)
    {
        popupSwipeStarted = e.Touches.Length == 1;
        if (popupSwipeStarted) { popupTouchX = e.Touches[0].ClientX; popupTouchY = e.Touches[0].ClientY; }
    }
    private void PopupTouchEnd(TouchEventArgs e)
    {
        if (!popupSwipeStarted || e.ChangedTouches.Length == 0) return;
        popupSwipeStarted = false;
        double x = e.ChangedTouches[0].ClientX - popupTouchX, y = e.ChangedTouches[0].ClientY - popupTouchY;
        if (Math.Abs(x) >= 80 && Math.Abs(x) > Math.Abs(y) * 1.5) CloseMealPopup();
    }
    private void CancelPopupSwipe(TouchEventArgs e) => popupSwipeStarted = false;

    private static double Parse(string value) => double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var number)
        ? number : double.TryParse(value, out number) ? number : double.NaN;
    private double? AnalysisWeight()
    {
        if (BotSession.Receipt?.Scan.WeightGrams is double measured)
        {
            if (measured <= 0) throw new InvalidOperationException("Captured weight is 0 g. Reweigh and submit a new scan on the robot.");
            return measured;
        }
        if (string.IsNullOrWhiteSpace(weight)) return null;
        double manual = Parse(weight);
        if (!double.IsFinite(manual) || manual <= 0) throw new InvalidOperationException("Enter a positive weight or leave it blank if unavailable.");
        return manual;
    }
    private async Task AnalyzeAsync()
    {
        if (!CanAnalyze) return;
        string id = draftScanId!;
        busy = true; analyzing = true; message = "";
        try
        {
            var result = await Api.AnalyzeAsync(Session.Token!, photoPath!, AnalysisWeight());
            if (disposed || draftScanId != id || !BotSession.CanAnalyze) return;
            if (!result.IsFood) { Show("The image does not appear to contain food.", true); return; }
            foodName = result.FoodName;
            calories = result.Calories.ToString(CultureInfo.InvariantCulture);
            protein = result.ProteinGrams.ToString(CultureInfo.InvariantCulture);
            carbs = result.CarbsGrams.ToString(CultureInfo.InvariantCulture);
            fat = result.FatGrams.ToString(CultureInfo.InvariantCulture);
            if (!string.IsNullOrWhiteSpace(result.Notes)) notes = result.Notes;
            // AI never replaces the robot's measured weight or invents a sensor reading.
            showMealPopup = true;
            Show("Analysis ready. Review the estimates before saving.", false);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; analyzing = false; }
    }
    private async Task SaveAsync()
    {
        if (busy || !BotSession.CanAnalyze || draftScanId == null || savedScanId == draftScanId) return;
        double? grams;
        try { grams = AnalysisWeight(); }
        catch (Exception ex) { Show(ex.Message, true); return; }
        double p = string.IsNullOrWhiteSpace(protein) ? 0 : Parse(protein);
        double c = string.IsNullOrWhiteSpace(carbs) ? 0 : Parse(carbs);
        double f = string.IsNullOrWhiteSpace(fat) ? 0 : Parse(fat);
        if (string.IsNullOrWhiteSpace(foodName) || !int.TryParse(calories, out int kcal) || kcal <= 0
            || !double.IsFinite(p) || p < 0 || !double.IsFinite(c) || c < 0 || !double.IsFinite(f) || f < 0)
        { Show("Enter a food name, positive calories and valid non-negative macros.", true); return; }
        busy = true; saving = true;
        bool localNotesFailed = false;
        try
        {
            var saved = await Api.SaveMealAsync(Session.Token!, new Meal
            {
                FoodName = foodName.Trim(), MealType = mealType, WeightGrams = grams ?? 0,
                Calories = kcal, ProteinGrams = p, CarbsGrams = c, FatGrams = f
            });
            savedScanId = draftScanId; // Never resubmit after the server has confirmed creation.
            try
            {
                if (!string.IsNullOrWhiteSpace(ingredients) || !string.IsNullOrWhiteSpace(notes))
                    Notes.Save(saved.UserId, saved.Id, new() { Ingredients = ingredients, Note = notes });
            }
            catch { localNotesFailed = true; }
            // Finish local receipt bookkeeping even if navigation disposed this screen during the API request.
            await BotSession.CompleteAsync(CancellationToken.None);
            if (disposed) return;
            showMealPopup = false;
            ClearDraft();
            if (localNotesFailed) Show("Meal saved, but its local notes could not be stored.", true);
            else await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Show(savedScanId == draftScanId ? "Meal saved; local receipt update needs attention. Do not save it again. " + ex.Message
                : "Could not save meal: " + ex.Message, true);
        }
        finally { busy = false; saving = false; }
    }
    private void ResetNutrition()
    {
        foodName = ""; mealType = "Lunch"; calories = ""; protein = ""; carbs = ""; fat = ""; ingredients = ""; notes = "";
        weight = BotSession.Receipt?.Scan.WeightGrams?.ToString("0.#", CultureInfo.InvariantCulture) ?? "";
        message = ""; hasError = false;
    }
    private void ClearDraft()
    {
        ResetNutrition();
        draftScanId = null; savedScanId = null; photoPath = null; previewData = null;
    }
    private void Show(string text, bool error) { if (!disposed) { message = text; hasError = error; } }

    private Task SimulateSubmit()
    {
#if DEBUG
        if (Robot is MockCalFitBotService mock)
        {
            if (!double.IsFinite(simulationWeight) || simulationWeight < 0) { Show("Enter a valid simulated weight.", true); return Task.CompletedTask; }
            mock.WeightGrams = simulationWeight;
            if (Enum.TryParse<CalFitBotMockScenario>(simulationScenario, out var scenario)) mock.Submit(scenario);
            return Retry();
        }
#endif
        return Task.CompletedTask;
    }
    private Task SimulateDuplicate()
    {
#if DEBUG
        if (Robot is MockCalFitBotService mock) { mock.ReplayLastScan(); return Retry(); }
#endif
        return Task.CompletedTask;
    }
    private Task SimulateConnection()
    {
#if DEBUG
        if (Robot is MockCalFitBotService mock) { mock.Connected = !mock.Connected; return Retry(); }
#endif
        return Task.CompletedTask;
    }
    private Task SimulateStandby()
    {
#if DEBUG
        if (Robot is MockCalFitBotService mock) { mock.Standby = !mock.Standby; return Retry(); }
#endif
        return Task.CompletedTask;
    }
    private Task SimulateTimeout()
    {
#if DEBUG
        if (Robot is MockCalFitBotService mock) { mock.SimulateTimeout = !mock.SimulateTimeout; return Retry(); }
#endif
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        BotSession.Changed -= OnRobotChanged;
        await lifetime.CancelAsync();
        await BotSession.DisposeAsync();
        lifetime.Dispose();
        // Robot photos are durable inbox data; navigation must never delete them.
    }
}
