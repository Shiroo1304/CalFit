<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
    xmlns:components="clr-namespace:CalFit.Components"
    x:Class="CalFit.MainPage"
    BackgroundColor="#07130F"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="Container">

	<blazor:BlazorWebView
        HostPage="wwwroot/index.html"
        BlazorWebViewInitialized="OnBlazorWebViewInitialized">

		<blazor:BlazorWebView.RootComponents>
			<blazor:RootComponent
                Selector="#app"
                ComponentType="{x:Type components:CalFitRoot}" />
		</blazor:BlazorWebView.RootComponents>

	</blazor:BlazorWebView>

</ContentPage>